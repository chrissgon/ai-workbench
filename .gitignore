# Secrets never live in this repo. Providers read credentials from the environment.
.env
.env.*
!.env.example

# Adapter build outputs are regenerated by adapters/<harness>/build.*
adapters/*/build/

# Eval workspaces written by skills/core-skill-creator/scripts/eval_run.py
*-workspace/

# Python
__pycache__/
*.pyc

# OS / editors
.DS_Store
