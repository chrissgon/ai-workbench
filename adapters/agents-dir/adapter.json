{
  "harness": "agents-dir",
  "covers": [
    "Codex",
    "Cursor",
    "Cline",
    "OpenCode",
    "OpenClaw",
    "any tool that reads .agents/skills or ~/.agents/skills"
  ],
  "consumes": [
    "skills"
  ],
  "strategy": {
    "skills": "symlink each selected skills/<name> into ~/.agents/skills/<name> (or ./.agents/skills with --project); selection by --pack"
  },
  "install": "install.sh [--pack <name>]",
  "generated": [],
  "eval_runner": "run-prompt.sh"
}
