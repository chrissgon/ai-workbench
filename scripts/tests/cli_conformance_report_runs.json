{
  "skills/design-brief/scripts/lint_brief.py": {
    "args": ["--file", "brief.md", "--type", "screen", "--values", "inline"],
    "files": {"brief.md": "# Brief\n"}
  },
  "skills/design-handoff/scripts/lint_handoff.py": {
    "args": ["--file", "handoff.md", "--flows", "flows.md", "--screen", "SCREEN-1"],
    "files": {"handoff.md": "# Handoff\n", "flows.md": "# Flows\n"}
  },
  "skills/design-ux-flows/scripts/lint_flows.py": {
    "args": ["--file", "flows.md", "--prd", "prd.md"],
    "files": {"flows.md": "# Flows\n", "prd.md": "# PRD\n"}
  },
  "skills/eng-architecture/scripts/check_design.py": {
    "args": ["--spec", "spec.md", "--design", "design.md"],
    "files": {"spec.md": "# Spec\n\n- REQ-1: the list loads\n", "design.md": "# Design\n"}
  },
  "skills/product-backlog/scripts/lint_backlog.py": {
    "args": ["--backlog", "backlog.md", "--spec", "spec.md", "--feature", "ab"],
    "files": {"backlog.md": "# Backlog\n\n- T-ab-1: list\n  Does: loads the list\n", "spec.md": "# Spec\n\n- REQ-1: the list loads\n"}
  },
  "skills/product-feature-spec/scripts/lint_spec.py": {
    "args": ["--file", "spec.md"],
    "files": {"spec.md": "# Feature specification: list\n\n## Functional requirements\n\n- REQ-1: the list loads\n"}
  }
}
